# Up to three NVIDIA API keys for automatic fallback on rate-limit / server errors.
# The first key is the primary; the runtime rotates to the next on each retriable
# error and loops back to the first when the last key also fails.
NVIDIA_API_KEY1=your_first_nvidia_api_key_here
NVIDIA_API_KEY2=your_second_nvidia_api_key_here
NVIDIA_API_KEY3=your_third_nvidia_api_key_here
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b
